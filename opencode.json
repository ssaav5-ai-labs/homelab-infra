{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM gateway",
      "options": { "baseURL": "{env:LLM_GATEWAY_URL}/v1", "apiKey": "{env:LLM_GATEWAY_KEY}" },
      "models": {
        "fast":   { "name": "fast",   "limit": { "context": 200000, "output": 8000 } },
        "code":   { "name": "code",   "limit": { "context": 200000, "output": 8000 } },
        "reason": { "name": "reason", "limit": { "context": 200000, "output": 8000 } }
      }
    }
  },
  "model": "gateway/code",
  "permission": {
    "shell": {
      "*": "allow",
      "rm *": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "sudo *": "ask",
      "docker *": "ask"
    }
  },
  "mcp": {
    "open-knowledge": {
      "type": "local",
      "enabled": true,
      "command": ["ok", "mcp"]
    }
  }
}
