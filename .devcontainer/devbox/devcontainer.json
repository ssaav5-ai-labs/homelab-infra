{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.37.1",
      "helm": "4.3.1",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "runArgs": [
    "--env-file=/home/debian/.devbox/env"
  ],
  "containerEnv": {
    "SOPS_AGE_KEY_FILE": "/home/vscode/.sops-age/keys.txt"
  },
  "mounts": [
    "source=opencode-data,target=/home/vscode/.local/share/opencode,type=volume",
    "source=/home/debian/.kube,target=/home/vscode/.kube,type=bind",
    "source=/home/debian/.devbox/ssh,target=/home/vscode/.ssh,type=bind",
    "source=/home/debian/code/github.com/ssaav5-ai-labs/handbook,target=/knowledge/handbook,type=bind",
    "source=/home/debian/.sops-age,target=/home/vscode/.sops-age,type=bind"
  ],
  "forwardPorts": [],
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.local && git config --global --add safe.directory ${containerWorkspaceFolder} && git config --global core.autocrlf input && sudo apt-get update -qq && sudo apt-get install -y -q tmux && npm install -g opencode-ai@1.19.3 @inkeep/open-knowledge"
}
